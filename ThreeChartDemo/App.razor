@using System.Diagnostics
@using System.Globalization
@using System.Runtime.InteropServices
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="layout">
    <aside class="panel @(_panelOpen ? "" : "collapsed")">
        <h1>Adaptive 3D function graph</h1>
        <p class="hint">Blazor WebAssembly AOT + NCalc + ThreeJS</p>

        <label for="formula">f(x, y, t) =</label>
        <textarea id="formula" class="formula" rows="5" spellcheck="false" autocomplete="off"
                  @bind="_settings.Formula" @bind:event="oninput"></textarea>

        <label>Examples
            <select @bind="_selectedExample" @bind:after="ApplyExample">
                <option value="">Choose an example…</option>
                @foreach (var ex in Examples)
                {
                    <option value="@ex.Formula">@ex.Name</option>
                }
            </select>
        </label>

        <div class="grid3">
            <label>X min <input type="number" step="any" @bind="_settings.XMin" /></label>
            <label>X max <input type="number" step="any" @bind="_settings.XMax" /></label>
            <label>X divisions <input type="number" min="1" max="@ChartSettings.MaxDivisions" @bind="_settings.DivisionsX" /></label>

            <label>Y min <input type="number" step="any" @bind="_settings.YMin" /></label>
            <label>Y max <input type="number" step="any" @bind="_settings.YMax" /></label>
            <label>Y divisions <input type="number" min="1" max="@ChartSettings.MaxDivisions" @bind="_settings.DivisionsY" /></label>

            <label>T min <input type="number" step="any" @bind="_settings.TMin" /></label>
            <label>T max <input type="number" step="any" @bind="_settings.TMax" /></label>
            <label>T divisions <input type="number" min="1" max="@ChartSettings.MaxTimeDivisions" @bind="_settings.DivisionsT" /></label>
        </div>

        <label class="check">
            <input type="checkbox" @bind="_settings.Adaptive" /> Adaptive mesh (all frames precomputed)
        </label>
        @if (_settings.Adaptive)
        {
            <div class="grid3">
                <label>Epsilon <input type="number" step="any" min="0" @bind="_settings.Epsilon" /></label>
                <label>Max refinements <input type="number" min="0" max="30" @bind="_settings.MaxRefinements" /></label>
                <label>Max triangles <input type="number" min="100" step="1000" @bind="_settings.MaxTriangles" /></label>
            </div>
            <label class="check">
                <input type="checkbox" @bind="_settings.LaplacianSmoothing" /> Laplacian smoothing
            </label>
            <p class="hint">X / Y divisions define the initial coarse grid. A triangle is refined when f at its centre differs
                from the linear interpolation of its vertices by more than epsilon times range of f.
            </p>
        }

        <label>Speed (time steps per second)
            <input type="number" min="1" max="120" @bind="_settings.StepsPerSecond" />
        </label>

        <button type="button" class="primary" disabled="@_creating" @onclick="CreateChartAsync">
            @(_creating
                ? (_settings.Adaptive ? $"Precomputing frames… {_progress:P0}" : $"Computing… {_progress:P0}")
                : "Create graph")
        </button>

        <button type="button" class="@(_animating ? "secondary active" : "secondary")" disabled="@(!HasChart || _creating)" @onclick="ToggleAnimation">
            @(_animating ? "⏸ Pause animation" : "▶ Start animation")
        </button>

        <label>Time: t = @_tText (step @_tIndex / @_tCount)
            <input type="range" min="0" max="@_tCount" value="@_tIndex" disabled="@(!HasChart || _creating)" @oninput="OnTimeSliderInput" />
        </label>

        <label class="check">
            <input type="checkbox" checked="@_wireframe" @onchange="OnWireframeChanged" /> Wireframe
        </label>
        <label class="check">
            <input type="checkbox" checked="@_heatMap" @onchange="OnHeatMapChanged" /> Heat map on the floor (16 levels)
        </label>
        <label class="check">
            <input type="checkbox" checked="@_contours" disabled="@(!_heatMap)" @onchange="OnContoursChanged" /> Contour lines
        </label>
        <button type="button" class="secondary" @onclick="ResetViewAsync">Reset view</button>

        @if (_error is not null)
        {
            <div class="msg error">@_error</div>
        }
        else if (_info is not null)
        {
            <div class="msg">@_info</div>
        }

        <details>
            <summary>Syntax help</summary>
            <p>
                Variables <code>x</code>, <code>y</code>, <code>t</code>; constants <code>pi</code>, <code>e</code>.<br />
                Functions (any letter case): <code>sin cos tan asin acos atan atan2 sqrt abs exp log log10 pow floor ceiling round min max sign if</code>.<br />
                Power: <code>pow(x, 2)</code> (the <code>^</code> operator is not power).<br />
                Points where f is undefined (NaN, ∞) are left as holes.<br />
                Animation runs t from T min to T max and back, forever.
            </p>
        </details>
    </aside>

    <main class="view" @ref="_host"></main>

    <button type="button" class="panel-toggle" @onclick="() => _panelOpen = !_panelOpen" title="Show / hide controls">
        @(_panelOpen ? "✕" : "☰ Controls")
    </button>
</div>

@code {
    private static readonly (string Name, string Formula)[] Examples =
    {
        ("Traveling waves", "sin(x + t) + cos(y - t)"),
        ("Plane wave", "sin(x + t) + cos(x + t)"),
        ("Ripples from the centre", "sin(sqrt(x*x + y*y) - 3*t)"),
        ("Gaussian wave packet", "exp(-(x*x + y*y) / 8) * cos(2*x - 3*t)"),
        ("Moving peak (sharp, good for adaptive)", "3 * exp(-((x - 3*cos(t))*(x - 3*cos(t)) + (y - 3*sin(t))*(y - 3*sin(t))))"),
        ("Moving two peaks", "3 * exp(-((x - 3*cos(t))*(x - 3*cos(t)) + (y - 3*sin(t))*(y - 3*sin(t)))) + 3 * exp(-((x - 3*cos(-t))*(x - 3*cos(-t)) + (y - 3*sin(-t))*(y - 3*sin(-t))))"),
        ("Interference", "sin(x*y + t)"),
        ("Fan", "sin(8*atan2(y,x)+t)*(x*x + y*y)"),
        ("Advanced", "x*sin(2*x + t) + y*cos(2*y - t)"),
    };

    private string _selectedExample = "";

    private readonly ChartSettings _settings = new();
    private ElementReference _host;
    private IJSObjectReference? _module;

    // Exactly one of these is set after a chart was created:
    private SurfaceMeshBuilder? _builder;     // uniform grid: one mesh, heights recomputed every frame
    private AdaptiveSurface? _adaptive;       // adaptive: one precomputed mesh per time step

    private bool HasChart => _builder is not null || _adaptive is not null;

    private bool _busy;           // grid is being evaluated / frame is being sent (blocks overlapping work)
    private bool _creating;       // "Create chart" in progress
    private bool _animating;
    private bool _loopRunning;
    private bool _disposed;
    private bool _wireframe = true;
    private bool _heatMap = true;
    private bool _contours = false;
    private bool _panelOpen = true;
    private long _stepIndex;      // ever-growing animation counter
    private int _tIndex;          // current discrete time index 0..N
    private int _tCount;
    private string _tText = "-";
    private double _progress;
    private string? _error;
    private string? _info;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _tCount = _settings.DivisionsT;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/scene.js");
        await _module.InvokeVoidAsync("init", _host);
        await _module.InvokeVoidAsync("setHeatMap", _heatMap);
        await _module.InvokeVoidAsync("setContours", _contours);

        // Deep link: ?sample=Plane%20wave loads that example instead of the default formula.
        var sampleName = await _module.InvokeAsync<string?>("getQueryParam", "sample");
        if (!string.IsNullOrWhiteSpace(sampleName))
        {
            var sample = Examples.FirstOrDefault(e =>
                string.Equals(e.Name, sampleName.Trim(), StringComparison.OrdinalIgnoreCase));
            if (sample.Formula is not null)
                _settings.Formula = sample.Formula;
        }

        await CreateChartAsync();   // draw the (default or selected) function immediately
    }

    // ---------------------------------------------------------------- chart creation

    private async Task CreateChartAsync()
    {
        if (_busy || _module is null) return;

        _error = _info = null;
        var validation = _settings.Validate();
        if (validation is not null) { _error = validation; return; }

        _busy = _creating = true;
        _progress = 0;
        StateHasChanged();

        try
        {
            var function = new FunctionEvaluator(_settings.Formula);   // parse (throws FormatException)
            var sw = Stopwatch.StartNew();

            if (_settings.Adaptive)
            {
                // Refinement is too slow for the animation loop: build the mesh of EVERY time step now.
                var surface = await AdaptiveSurface.BuildAsync(function, _settings, p =>
                {
                    _progress = p;
                    StateHasChanged();
                });
                var buffers = surface.GetBuffers(0);
                await SendMeshAsync("setMesh", buffers, surface.Bounds, withIndices: true);

                _adaptive = surface;
                _builder = null;
                _tCount = surface.TimeDivisions;
                _tIndex = 0;
                _stepIndex = 0;
                ShowAdaptiveInfo(surface, 0, sw.ElapsedMilliseconds, "Precomputed in");
            }
            else
            {
                var builder = new SurfaceMeshBuilder(function, _settings);   // snapshot of the settings
                builder.EstimateRange();
                await builder.UpdateAsync(builder.TimeAt(0), p => { _progress = p; StateHasChanged(); });

                await _module.InvokeVoidAsync("setMesh",
                    ToBytes(builder.Positions), ToBytes(builder.Colors), ToBytes(builder.Indices), builder.Bounds);

                _builder = builder;
                _adaptive = null;
                _tCount = builder.TimeDivisions;
                _tIndex = 0;
                _stepIndex = 0;
                ShowUniformInfo(builder, sw.ElapsedMilliseconds);
            }
        }
        catch (FormatException ex)
        {
            _error = "Invalid function: " + ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = _creating = false;
            StateHasChanged();
        }
    }

    // ---------------------------------------------------------------- animation

    private void ToggleAnimation()
    {
        if (!HasChart) return;

        _animating = !_animating;
        if (_animating && !_loopRunning)
            _ = RunAnimationAsync();
    }

    /// <summary>
    /// The animation loop: once per browser frame (requestAnimationFrame) check whether the next
    /// time step is due; if so show it. Uniform mode: evaluate f in C# and update the vertices.
    /// Adaptive mode: send the precomputed mesh of that time step.
    /// t goes tMin -> tMax -> tMin -> ... forever (ping-pong) until paused.
    /// </summary>
    private async Task RunAnimationAsync()
    {
        _loopRunning = true;
        var clock = Stopwatch.StartNew();
        double lastStep = clock.Elapsed.TotalSeconds;

        try
        {
            while (_animating && !_disposed && _module is not null)
            {
                await _module.InvokeVoidAsync("nextFrame");

                if (_busy || !HasChart) continue;

                double now = clock.Elapsed.TotalSeconds;
                if (now - lastStep < 1.0 / _settings.StepsPerSecond) continue;
                lastStep = now;

                _stepIndex++;
                await RenderTimeIndexAsync(PingPong(_stepIndex, _tCount));
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException) { }
        finally
        {
            _loopRunning = false;
            _animating = false;
            if (!_disposed) StateHasChanged();
        }
    }

    /// <summary>0,1,..,n,n-1,..,1,0,1,.. for step = 0,1,2,...</summary>
    private static int PingPong(long step, int n)
    {
        long period = 2L * n;
        long m = step % period;
        return (int)(m <= n ? m : period - m);
    }

    private async Task RenderTimeIndexAsync(int k)
    {
        if (_module is null || !HasChart) return;

        _busy = true;
        try
        {
            var sw = Stopwatch.StartNew();

            if (_adaptive is { } surface)
            {
                // The mesh differs in every frame (other vertex count, other triangles): send it whole.
                await SendMeshAsync("setMesh", surface.GetBuffers(k), surface.Bounds, withIndices: true);
                _tIndex = k;
                ShowAdaptiveInfo(surface, k, sw.ElapsedMilliseconds, "Frame");
            }
            else if (_builder is { } builder)
            {
                bool indicesChanged = await builder.UpdateAsync(builder.TimeAt(k));

                await _module.InvokeVoidAsync("updateMesh",
                    ToBytes(builder.Positions),
                    ToBytes(builder.Colors),
                    indicesChanged ? ToBytes(builder.Indices) : null,   // topology is usually unchanged
                    builder.Bounds);

                _tIndex = k;
                ShowUniformInfo(builder, sw.ElapsedMilliseconds);
            }
        }
        catch (Exception ex) when (ex is not JSDisconnectedException)
        {
            _error = ex.Message;
            _animating = false;
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task OnTimeSliderInput(ChangeEventArgs e)
    {
        if (_busy || !HasChart) return;
        if (!int.TryParse(e.Value?.ToString(), out int k)) return;

        k = Math.Clamp(k, 0, _tCount);
        _stepIndex = k;                 // animation continues from here, going forward
        await RenderTimeIndexAsync(k);
    }

    // ---------------------------------------------------------------- misc

    private async Task SendMeshAsync(string method, FrameBuffers b, double[] bounds, bool withIndices)
    {
        await _module!.InvokeVoidAsync(method,
            ToBytes(b.Positions), ToBytes(b.Colors), withIndices ? ToBytes(b.Indices) : null, bounds);
    }

    private void ShowUniformInfo(SurfaceMeshBuilder b, long ms)
    {
        double t = b.TimeAt(_tIndex);
        _tText = t.ToString("G5", CultureInfo.InvariantCulture);
        _info = $"Uniform grid: {b.VertexCount:N0} vertices, {b.TriangleCount:N0} triangles. " +
                $"f range [{b.FMin:G4}, {b.FMax:G4}]. Frame: {ms} ms.";
    }

    private void ShowAdaptiveInfo(AdaptiveSurface s, int k, long ms, string what)
    {
        double t = s.TimeAt(k);
        _tText = t.ToString("G5", CultureInfo.InvariantCulture);
        _info = $"Adaptive mesh: this frame {s.VertexCount(k):N0} vertices, {s.TriangleCount(k):N0} triangles " +
                $"(all frames: {s.TotalTriangles:N0} triangles, ~{s.ApproxMegabytes:N1} MB). " +
                $"f range [{s.FMin:G4}, {s.FMax:G4}]. {what}: {ms} ms.";
    }

    // float[] / uint[] -> byte[]: .NET sends byte[] to JS as a Uint8Array (binary, no JSON).
    private static byte[] ToBytes(ReadOnlySpan<float> data) => MemoryMarshal.AsBytes(data).ToArray();
    private static byte[] ToBytes(ReadOnlySpan<uint> data) => MemoryMarshal.AsBytes(data).ToArray();

    private async Task ApplyExample()
    {
        if (!string.IsNullOrEmpty(_selectedExample))
        {
            _settings.Formula = _selectedExample;

            // remember the choice in the address bar (no reload): ?sample=Plane%20wave
            var sample = Examples.FirstOrDefault(e => e.Formula == _selectedExample);
            if (sample.Name is not null && _module is not null)
                await _module.InvokeVoidAsync("setQueryParam", "sample", sample.Name);
        }
        _selectedExample = "";      // show the placeholder again, so the same example can be picked twice
    }

    private async Task OnWireframeChanged(ChangeEventArgs e)
    {
        _wireframe = e.Value is true;
        if (_module is not null) await _module.InvokeVoidAsync("setWireframe", _wireframe);
    }

    private async Task OnHeatMapChanged(ChangeEventArgs e)
    {
        _heatMap = e.Value is true;
        if (_module is not null) await _module.InvokeVoidAsync("setHeatMap", _heatMap);
    }

    private async Task OnContoursChanged(ChangeEventArgs e)
    {
        _contours = e.Value is true;
        if (_module is not null) await _module.InvokeVoidAsync("setContours", _contours);
    }

    private async Task ResetViewAsync()
    {
        if (_module is not null) await _module.InvokeVoidAsync("resetView");
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _animating = false;
        if (_module is null) return;
        try
        {
            await _module.InvokeVoidAsync("dispose");
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
